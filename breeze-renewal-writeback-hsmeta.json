{
  "uid": "breeze_renewal_writeback",
  "type": "workflow-action",
  "config": {
    "actionUrl": "https://agonzalez-cpu.github.io/renewal-app/",
    "isPublished": false,
    "supportedClients": [
      {
        "client": "AGENTS",
        "toolType": "TAKE_ACTION",
        "llmConfig": {
          "actionDescription": "Use this tool after a Breeze renewal analysis is complete. Send the HubSpot company ID and the full analysis output text or JSON. The service extracts Total Raw Score, Renewal Status, and Confidence, then previews or writes those values to the HubSpot company properties renewal_health_score, renewal_status, and renewal_confidence. Use mode dry_run while testing. Use mode write only when the user has approved updating the company record."
        }
      },
      {
        "client": "WORKFLOWS"
      }
    ],
    "inputFields": [
      {
        "typeDefinition": {
          "name": "companyId",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "breezeOutput",
          "type": "string",
          "fieldType": "textarea"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "executionId",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "agentInstanceId",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "breezeUrl",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "mode",
          "type": "enumeration",
          "fieldType": "select",
          "options": [
            {
              "value": "parse_only",
              "label": "Parse only"
            },
            {
              "value": "dry_run",
              "label": "Dry run"
            },
            {
              "value": "write",
              "label": "Write to HubSpot"
            }
          ]
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": false
      }
    ],
