        "inputFieldDescriptions": {
          "companyId": "The HubSpot company object ID to update. If this tool runs on a company record, the backend can also use the current company object ID.",
          "breezeOutput": "Paste or pass the full Breeze renewal analysis output. It can be JSON or text, but it must include Total Raw Score, Renewal Status, and Confidence.",
